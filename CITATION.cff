    given-names: "André Luiz"
    affiliation: "Sirius, Laboratório Nacional de Luz Síncrotron (LNLS), Centro Nacional de Pesquisa em Energia e Materiais (CNPEM), Campinas, SP, Brazil"
repository-code: "https://github.com/andrlupi/EMA-C_LM-Cryo-Modelling"
